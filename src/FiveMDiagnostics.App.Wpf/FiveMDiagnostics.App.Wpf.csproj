<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <!-- The released asset has always been FiveMDiagnostics.exe, and the updater matches
         the archive against the name of the running executable. -->
    <AssemblyName>FiveMDiagnostics</AssemblyName>
    <!-- A build made here carries the -local marker, which is how the updater tells a
         working copy of the source tree from something it may overwrite. -->
    <Version Condition="'$(Version)' == ''">1.0.0-local</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">1.0.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">1.0.0.0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">1.0.0-local</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FiveMDiagnostics.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Strings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FiveMDiagnostics.Core\FiveMDiagnostics.Core.csproj" />
    <ProjectReference Include="..\FiveMDiagnostics.Collectors\FiveMDiagnostics.Collectors.csproj" />
    <ProjectReference Include="..\FiveMDiagnostics.Analysis\FiveMDiagnostics.Analysis.csproj" />
    <ProjectReference Include="..\FiveMDiagnostics.Export\FiveMDiagnostics.Export.csproj" />
    <ProjectReference Include="..\FiveMDiagnostics.Integrations.PresentMon\FiveMDiagnostics.Integrations.PresentMon.csproj" />
    <ProjectReference Include="..\FiveMDiagnostics.Integrations.Obs\FiveMDiagnostics.Integrations.Obs.csproj" />
    <ProjectReference Include="..\FiveMDiagnostics.Integrations.Etw\FiveMDiagnostics.Integrations.Etw.csproj" />
    <ProjectReference Include="..\FiveMDiagnostics.Integrations.Nvml\FiveMDiagnostics.Integrations.Nvml.csproj" />
    <ProjectReference Include="..\FiveMDiagnostics.Fakes\FiveMDiagnostics.Fakes.csproj" />
  </ItemGroup>

</Project>
